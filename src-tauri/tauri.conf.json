{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multi LLM",
  "version": "1.0.5",
  "identifier": "com.multillm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Multi LLM",
        "width": 1040,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "recommends": [],
        "provides": [],
        "conflicts": [],
        "replaces": [],
        "section": "utility",
        "priority": "optional"
      }
    }
  }
}
