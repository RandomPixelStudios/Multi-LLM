{
  "name": "multi-llm",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check:web": "for f in src-tauri/web/*.js; do node --check \"$f\" || exit 1; done && echo web-js-ok",
    "presets": "node scripts/gen-presets.mjs",
    "presets:check": "node scripts/gen-presets.mjs --check",
    "legal": "node scripts/gen-legal.mjs",
    "legal:check": "node scripts/gen-legal.mjs --check",
    "update-manifest": "node scripts/gen-update-manifest.mjs",
    "update-manifest:check": "node scripts/gen-update-manifest.mjs --check",
    "preview": "vite preview",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
